{#=====================================================
  Family List
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

    <div class="family-container">

    <h2>Family Members</h2>

    <div class="family-code">
        <h3>Family Code</h3>
        <p>{{ families[0].family_code }}</p>
    </div>

    <div class="family-members">

        {% for family in families %}

            <div class="family-member">
                <p>{{ family.forename }} {{ family.surname }}</p>
                <span>{{ family.role }}</span>
            </div>

        {% endfor %}

    </div>

</div>

{% endblock %}

