{#=====================================================
  Family List
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

    <h2>Family Members</h2>
    <h3>Family Code: {{ families[0].family_code }}</h3>

    {% for family in families %}
        
        <div>
            <p>
                {{ family.forename }} {{ family.surname }}
                - {{ family.role }}
            </p>
        </div>

    {% endfor %}

{% endblock %}
