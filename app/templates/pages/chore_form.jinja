{#=====================================================
  Chore form page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <form method="post" action="/chore">
      <h3>New Chore</h3>

      <label>
          Title
          <input name="title" placeholder="e.g. Dinner" required>
      </label>

      <label>
          Body
          <textarea name="body" placeholder="e.g. Noodles with meat" required></textarea>
      </label>

      <label for="due_time">Due Date and Time:</label>

      <input
          type="datetime-local"
          id="due_time"
          name="due_time"
          required
      >

      <button>Add Chore</button>
  </form>

{% endblock %}

