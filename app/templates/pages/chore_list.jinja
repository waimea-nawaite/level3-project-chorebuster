{#=====================================================
  Chore List
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Chores</h2>

    <section id="chores">

        {% for chore in chores %}

            <div class="chore">

                <header>
                    <h3>{{ "📌" if chore.pinned }} {{ chore.title }}</h3>
                </header>

                <p>Body: {{chore.body}}</p>
                <p>Due Time (Mins): {{chore.due_time}}</p>
                <p>Points: {{chore.points}}</p>

                {% if session.logged_in and chore.uid == session.user.id %}
                    <button id="chore-button"><a href="/chore/delete/{{ chore.mid }}" onclick="return confirm('Are you sure?');">Delete</a></button>
                {% endif %}

            </div>

        {% else %}

            <p>No Chores!</p>

        {% endfor %}

    </section>

{% endblock %}

