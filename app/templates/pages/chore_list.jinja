{#=====================================================
  Chore List
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Chores</h2>

    <section id="chores">

        {% for chore in chores %}

            <div class="chore-card">
                <h3>{{chore.title}}</h3>

                <div class="chore-due">
                    Body: {{chore.body}}
                </div>

                <div class="chore-due">
                    Due at: {{chore.due_time}}
                </div>

                <div class="chore-points">
                    Points: {{chore.points}}
                </div>
                
                <a class="chore-button" href="/chore/complete/{{ chore.mid }}" onclick="return confirm('Are you sure?');">Complete</a>

                <div class="chore-bottom">
                {% if session.logged_in and chore.uid == session.user.id %}
                    <a class="chore-button" href="/chore/delete/{{ chore.mid }}" onclick="return confirm('Are you sure?');">Delete</a>
                    <a class="chore-button" href="/chore/edit/{{ chore.mid }}">Edit</a>
                {% endif %}
                </div>

            </div>

        {% else %}

            <p>No Chores!</p>

        {% endfor %}

    </section>

{% endblock %}



